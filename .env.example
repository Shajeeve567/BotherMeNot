# ─── Core ────────────────────────────────────────────────────────────────

API_BASE_URL=
# Where apps/web is served; users land on {WEB_BASE_URL}/dashboard after GitHub login
WEB_BASE_URL=http://localhost:5173
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=


# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL=postgresql://shaj:shaj@localhost:5435/notification_db

# API server port
PORT=3000

# ─── Redis / BullMQ ──────────────────────────────────────────────────────
# Queue connection (defaults to localhost:6379 if unset)
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Slack ────────────────────────────────────────────────────
# Bot token (xoxb-...) for the app that posts notifications
SLACK_BOT_TOKEN=
# Default channel the bot posts to (e.g. #engineering, C1234567890)
SLACK_DEFAULT_CHANNEL=
# Slack signing secret — verifies interactive callbacks (ack button)
SLACK_SIGNING_SECRET=
# How long before an unacknowledged high-priority alert escalates (minutes)
SLACK_ESCALATION_TIMEOUT_MINUTES=30

# ─── LLM — pick ONE provider ───────────────────────────────────
# Anthropic:
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5
# OpenAI (alternative):
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o

# Embeddings model for the Correlate stage (pgvector)
EMBEDDINGS_MODEL=text-embedding-3-small

# ─── Digest ────────────────────────────────────────────────────
# Cron expression for the low-priority digest batch job
DIGEST_CRON=0 * * * *


GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=