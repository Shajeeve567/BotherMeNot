# Copy this file to .env (never commit .env). dotenv-cli loads it from the repo root.
# Generate a random secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ─── Required ────────────────────────────────────────────────────────────

# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL=postgresql://shaj:shaj@localhost:5435/notification_db

# Signs session cookies and the GitHub App "state" token
JWT_SECRET=

# GitHub OAuth App — user login (github.com/settings/developers)
# Its callback URL must be {API_BASE_URL}/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# GitHub App — repo connections and webhooks (github.com/settings/apps)
#   Setup URL:   {API_BASE_URL}/github-app/setup  (tick "Redirect on update")
#   Webhook URL: a public URL (e.g. ngrok) + /webhooks/github/app
GITHUB_APP_ID=
# The slug in github.com/apps/<slug>
GITHUB_APP_SLUG=
# The downloaded .pem file, base64-encoded onto ONE line:
#   PowerShell:   [Convert]::ToBase64String([IO.File]::ReadAllBytes("path\to\key.pem"))
#   macOS/Linux:  base64 -w0 path/to/key.pem
GITHUB_APP_PRIVATE_KEY=
# Must equal the "Webhook secret" saved in the GitHub App settings (GitHub never
# shows it again). This is NOT the App's "Client secret".
GITHUB_APP_WEBHOOK_SECRET=

# Gemini API key used by apps/ai-engine
GOOGLE_GENERATIVE_AI_API_KEY=

# ─── Optional (defaults shown) ───────────────────────────────────────────
# Leave a variable out rather than blank: an empty value overrides the default.

# API server port
PORT=3000
# Public URL of this API
API_BASE_URL=http://localhost:3000
# Where apps/web is served; users land on {WEB_BASE_URL}/dashboard after login
# and after connecting GitHub
WEB_BASE_URL=http://localhost:5173
# Only set if the OAuth callback differs from {API_BASE_URL}/auth/github/callback
# GITHUB_OAUTH_REDIRECT_URI=

# Redis for BullMQ queues
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Planned — not read by any code yet ──────────────────────────────────
# Slack delivery (packages/notify)
# SLACK_BOT_TOKEN=
# SLACK_DEFAULT_CHANNEL=
# SLACK_SIGNING_SECRET=
# SLACK_ESCALATION_TIMEOUT_MINUTES=30

# Embeddings model for the correlate stage (pgvector)
# EMBEDDINGS_MODEL=text-embedding-3-small

# Cron for the low-priority digest batch job
# DIGEST_CRON=0 * * * *
